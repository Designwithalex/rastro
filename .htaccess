# ============================================================
# Rastro Fitness — .htaccess de la raíz (public_html)
# Todo el tráfico entra por index.php. Las carpetas privadas
# (app/, views/, data/) tienen su propio .htaccess que las cierra.
# ============================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Una sola dirección para el sitio --------------------
    # www.rastrofitness.com redirige a rastrofitness.com. Las dos
    # servían el mismo contenido sin redirigir una a la otra, y para
    # un buscador eso son dos sitios iguales compitiendo entre sí.
    #
    # Va PRIMERO, antes que cualquier otra regla: si se redirige
    # después de resolver la ruta, el visitante hace el viaje dos
    # veces y la URL final puede no ser la que se calculó.
    #
    # Se elige el dominio sin www porque es al que ya redirige el
    # http de Hostinger. El %1 es lo que capturó el paréntesis del
    # HTTP_HOST, así que la regla sigue funcionando el día que el
    # sitio cambie de dominio otra vez.
    #
    # SON DOS REGLAS Y NO UNA, Y LA RAZÓN ES EL CHECKOUT.
    #
    # Ante un 301, el navegador reemite la petición como GET y tira el
    # cuerpo. Para un enlace da igual; para el formulario de compra
    # significa que los datos se pierden y la persona vuelve a
    # /checkout sin nada, sin ningún error y sin entender por qué.
    # Pasó de verdad el 11/09/2026, con las páginas de www todavía
    # cacheadas en el CDN: el formulario se enviaba a www, rebotaba
    # acá convertido en GET, y el pago nunca salía.
    #
    # 308 es el 301 que SÍ conserva el método y el cuerpo. Se usa para
    # todo lo que no sea GET ni HEAD, y para esos dos se deja el 301 de
    # siempre, que es el que los buscadores entienden mejor.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
    RewriteRule ^ https://%1%{REQUEST_URI} [R=308,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Un archivo o una carpeta que existe de verdad se sirve tal cual:
    # así salen los assets sin pasar por PHP.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás lo resuelve el front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # El sitio no usa CDN ni scripts de terceros: todo sale de su propio origen.
    # Ojo: con esta política no se pueden usar atributos style="" ni <script> en
    # línea.
    #
    # MERCADO PAGO NECESITA UNA SOLA EXCEPCIÓN: form-action.
    #
    # Acá había escrito que no hacía falta ninguna, porque el pago es una
    # redirección del servidor y no un script de terceros. Eso es cierto
    # para script-src, connect-src y frame-src, y es la razón por la que
    # Checkout Pro le gana a Bricks. Pero es FALSO para form-action, y el
    # detalle cuesta un checkout entero:
    #
    #   form-action no sólo limita a dónde puede apuntar un formulario:
    #   Chrome lo aplica también a las REDIRECCIONES que salen de enviarlo.
    #
    # El navegador manda el POST a /checkout —mismo origen, permitido—, el
    # servidor contesta 303 hacia mercadopago.com, y Chrome cancela esa
    # navegación porque el destino no está en la lista. La persona aprieta
    # "Ir a pagar" y no pasa absolutamente nada: sin error en pantalla, sin
    # cambio de página, sólo una línea en la consola.
    #
    # Y no se ve probando con curl ni con wget, porque ninguno aplica CSP.
    # Pasó el 11/09/2026 y se diagnosticó leyendo esta cabecera, no el log.
    #
    # Se listan los dominios con y sin comodín a propósito: en CSP
    # `*.mercadopago.com.ar` NO incluye a `mercadopago.com.ar`.
    #
    # Si algún día se prueba Bricks (el checkout embebido), hay que sumar
    # https://sdk.mercadopago.com a script-src y sus dominios a connect-src y
    # frame-src. Está anotado en docs/MERCADOPAGO.md.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://mercadopago.com.ar https://*.mercadopago.com.ar https://mercadopago.com https://*.mercadopago.com https://mercadolibre.com.ar https://*.mercadolibre.com.ar; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'"

    # Las tipografías propias se pueden cachear un año: el nombre no cambia.
    <FilesMatch "\.(woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- Tipos que Hostinger no siempre trae declarados ---
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caché de estáticos. El ?v= de asset() se encarga de invalidarla. ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 6 months"
    ExpiresByType image/png               "access plus 6 months"
    ExpiresByType image/webp              "access plus 6 months"
    ExpiresByType image/svg+xml           "access plus 6 months"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresDefault                        "access plus 1 hour"
</IfModule>

# --- El repositorio no se sirve nunca ---
# Hoy .github/workflows/deploy.yml no sincroniza .git/, así que en el servidor
# no existe. Esto es por si algún día el despliegue cambia de método: .git/config
# trae la URL del repositorio y el historial trae todo lo que alguna vez se
# commiteó.
RedirectMatch 404 /\.git(/|$)

# --- Nunca servir archivos sensibles, pase lo que pase con el rewrite ---
# Los .json van acá aparte del Require all denied de data/: si un día alguien
# mueve o renombra ese archivo, los mocks —settings con el WhatsApp, users con
# los hashes— no quedan colgando de una sola línea de defensa.
# Los .log entraron con el checkout: data/mp-eventos.log guarda qué pasó con
# cada pago, y ahí figuran códigos de pedido e ids de operación.
<FilesMatch "\.(json|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(\.env|\.gitignore|composer\.(json|lock)|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
