# Credenciales — NUNCA versionar
app/config.php
.env
*.local.php

# Datos que escribe el sitio, no la persona.
# data/pedidos.json lo crea el checkout con cada compra de prueba y
# data/mp-eventos.log guarda la conversación con Mercado Pago. Los dos
# tienen datos de compradores (nombre, correo, dirección) y no van al repo.
# Los mocks escritos a mano —orders.json, products.json— sí se versionan.
data/pedidos.json
data/mp-eventos.log

# Sistema
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Build / temporales
*.log
/tmp/
node_modules/

# Originales pesados sin optimizar
assets/img/**/*.psd
assets/img/**/*.ai

# Fotos originales sin optimizar. bin/optimizar-imagenes.sh deja acá una copia
# intacta antes de redimensionar. Pesan 29 MB: no van al repo ni al servidor.
.originales-img/

# Pedidos de arrepentimiento: tienen datos de compradores y los escribe el
# sitio, no una persona. Misma razón que data/pedidos.json.
data/arrepentimientos.json

# Tokens de recuperación de contraseña: los escribe el sitio y valen una hora.
data/recuperaciones.json
